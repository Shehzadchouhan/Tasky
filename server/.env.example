PORT=5000
MONGODB_URI=mongodb://localhost:27017/taskly
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODELS=primary-model,fallback-model-1,fallback-model-2

# AI Assistant Quota & Budget Guard (in-memory, per instance, reset on restart)
AI_DAILY_CALL_CAP=200
AI_USER_PER_MINUTE=5
AI_USER_PER_DAY=30